{
  // Foam: [[wikilinks]], backlinks, graph and note templates (.foam/templates/)
  "foam.files.ignore": [
    "**/.vscode/**/*",
    "**/.product/**/*",
    "**/.claude/**/*",
    "**/node_modules/**/*"
  ],
  // Keep story files plain: no link reference definitions appended at the bottom
  "foam.edit.linkReferenceDefinitions": "off",
  "foam.files.newNotePath": "currentDir",

  // The product clone is a read-only mirror, kept out of search results
  "files.readonlyInclude": {
    ".product/**": true
  },
  "search.exclude": {
    ".product": true
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true
  },

  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    }
  },
  // Markdown All in One: don't renumber the numbered steps of test cases on edit
  "markdown.extension.orderedList.autoRenumber": false
}
